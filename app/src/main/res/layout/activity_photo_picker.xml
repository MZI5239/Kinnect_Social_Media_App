<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/photo_picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_bg"
    tools:context=".PhotoPickerActivity">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/picker_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_picker_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:padding="8dp"
            android:text="Cancel"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Recents"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/keyboard_arrow_down"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_picker_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Next (2)"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Options Sub-bar -->
    <LinearLayout
        android:id="@+id/ll_picker_subbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/picker_top_bar">

        <ImageView
            android:id="@+id/btn_open_camera_from_picker"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="Camera"
            android:focusable="true"
            android:src="@drawable/ic_search"
            app:tint="@color/text_primary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Select Multiple Pill -->
        <LinearLayout
            android:id="@+id/btn_select_multiple"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_input_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/more_horizontal"
                app:tint="@color/primary_teal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:text="SELECT MULTIPLE"
                android:textColor="@color/primary_teal"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Photo Grid Scroll Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/card_bg"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/picker_bottom_nav"
        app:layout_constraintTop_toBottomOf="@id/ll_picker_subbar">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:columnOrderPreserved="false">

            <!-- Item 1 (Selected 1) -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="1dp"
                android:background="#D1C4E9">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_kinnect_logo_teal"
                    app:tint="#600B5F63" />

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/primary_teal"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Item 2 (Selected 2) -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="1dp"
                android:background="#BBDEFB">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_kinnect_logo_teal"
                    app:tint="#600B5F63" />

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/primary_teal"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Item 3 -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="1dp"
                android:background="#C8E6C9">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_kinnect_logo_teal"
                    app:tint="#300B5F63" />
            </FrameLayout>

            <!-- Item 4 -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="1dp"
                android:background="#FFCDD2">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_kinnect_logo_teal"
                    app:tint="#300B5F63" />
            </FrameLayout>

            <!-- Item 5 -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="1dp"
                android:background="#FFE0B2">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_kinnect_logo_teal"
                    app:tint="#300B5F63" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#99000000"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="0:23"
                    android:textColor="@color/white"
                    android:textSize="11sp" />
            </FrameLayout>

            <!-- Item 6 -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="1dp"
                android:background="#B2EBF2">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_kinnect_logo_teal"
                    app:tint="#300B5F63" />
            </FrameLayout>

            <!-- Item 7 -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="1dp"
                android:background="#E1BEE7">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_kinnect_logo_teal"
                    app:tint="#300B5F63" />
            </FrameLayout>

            <!-- Item 8 -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="1dp"
                android:background="#D7CCC8">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_kinnect_logo_teal"
                    app:tint="#300B5F63" />
            </FrameLayout>

            <!-- Item 9 -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_margin="1dp"
                android:background="#CFD8DC">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_kinnect_logo_teal"
                    app:tint="#300B5F63" />
            </FrameLayout>

        </GridLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/picker_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#1C1B1F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Gallery"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Photo"
            android:textColor="#B0FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Video"
            android:textColor="#B0FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>