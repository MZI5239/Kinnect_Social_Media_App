<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reaction_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    tools:context=".ReactionPickerActivity">

    <!-- Container for Reaction Floating Popup Card -->
    <LinearLayout
        android:id="@+id/reaction_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <!-- Reaction 1: Like 👍 -->
        <TextView
            android:id="@+id/reaction_like"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="👍"
            android:textSize="28sp" />

        <!-- Reaction 2: Love ❤️ -->
        <TextView
            android:id="@+id/reaction_love"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="❤️"
            android:textSize="28sp" />

        <!-- Reaction 3: Haha 😆 -->
        <TextView
            android:id="@+id/reaction_haha"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="😆"
            android:textSize="28sp" />

        <!-- Reaction 4: Wow 😮 -->
        <TextView
            android:id="@+id/reaction_wow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="😮"
            android:textSize="28sp" />

        <!-- Reaction 5: Sad 😢 -->
        <TextView
            android:id="@+id/reaction_sad"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="😢"
            android:textSize="28sp" />

        <!-- Reaction 6: Angry 😡 -->
        <TextView
            android:id="@+id/reaction_angry"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="😡"
            android:textSize="28sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>