<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".CameraActivity">

    <!-- Top Action Controls Bar -->
    <LinearLayout
        android:id="@+id/camera_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_camera_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_camera_flash"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="Flash"
            android:focusable="true"
            android:src="@drawable/more_horizontal"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btn_camera_flip"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="20dp"
            android:clickable="true"
            android:contentDescription="Flip Camera"
            android:focusable="true"
            android:src="@drawable/more_horizontal"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Center Camera Preview Placeholder with Scenic BG -->
    <FrameLayout
        android:id="@+id/camera_viewfinder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#CDDAC0"
        app:layout_constraintBottom_toTopOf="@id/ll_shutter_controls"
        app:layout_constraintTop_toBottomOf="@id/camera_top_bar">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_kinnect_logo_teal"
            app:tint="#400B5F63" />

        <!-- Vertical Right Toolbar -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#40000000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="Aa"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@null"
                android:src="@drawable/more_horizontal"
                app:tint="@color/white" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_globe"
                app:tint="@color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#80000000"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Tap shutter button to capture story"
            android:textColor="@color/white"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- Shutter Controls Bar -->
    <LinearLayout
        android:id="@+id/ll_shutter_controls"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="#000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@id/mode_selector_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Gallery Thumbnail Preview -->
        <FrameLayout
            android:id="@+id/btn_camera_gallery"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#33FFFFFF"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Gallery"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Shutter Button (Outer ring + inner white circle) -->
        <FrameLayout
            android:id="@+id/btn_shutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#000000" />

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="@color/white" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Switch / Flip Button -->
        <FrameLayout
            android:id="@+id/btn_camera_switch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#33FFFFFF"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Switch"
                android:src="@drawable/more_horizontal"
                app:tint="@color/white" />
        </FrameLayout>

    </LinearLayout>

    <!-- Bottom Mode Selector Bar -->
    <HorizontalScrollView
        android:id="@+id/mode_selector_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#000000"
        android:paddingVertical="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="TEXT"
                android:textColor="#B0FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="LIVE"
                android:textColor="#B0FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="STORY"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="POST"
                android:textColor="#B0FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="BOOMERANG"
                android:textColor="#B0FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>