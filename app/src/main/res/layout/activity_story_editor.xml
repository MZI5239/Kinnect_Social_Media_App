<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/story_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".StoryEditorActivity">

    <!-- Story Canvas Background Image / Preview -->
    <FrameLayout
        android:id="@+id/story_canvas_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CDDAC0">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_kinnect_logo_teal"
            app:tint="#400B5F63" />

        <!-- Overlaid Story Text -->
        <TextView
            android:id="@+id/tv_story_overlay_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#80000000"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="Saturday plans"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Top Editing Tools Bar -->
    <LinearLayout
        android:id="@+id/editor_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_story_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#40000000"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Aa Tool -->
        <TextView
            android:id="@+id/btn_tool_text"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#40000000"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Aa"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Sticker Tool -->
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#40000000"
            android:gravity="center"
            android:text="😊"
            android:textSize="16sp" />

        <!-- Save Tool -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#40000000"
            android:contentDescription="Save"
            android:padding="6dp"
            android:src="@drawable/more_horizontal"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Bottom Share Action Bar -->
    <LinearLayout
        android:id="@+id/editor_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Share to Your Story Button -->
        <LinearLayout
            android:id="@+id/btn_share_your_story"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#80000000"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_avatar_circle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/user_initials"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Your story"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Close Friends Button -->
        <LinearLayout
            android:id="@+id/btn_share_close_friends"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="#80000000"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_avatar_circle"
                android:backgroundTint="#2E7D32">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="★"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Close friends"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Send Arrow Circular Button -->
        <FrameLayout
            android:id="@+id/btn_story_send_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_circle"
            android:backgroundTint="@color/white"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_back"
                android:rotation="180"
                app:tint="@color/black" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>